# Copy to /etc/jadel-support-api/staging.env ONLY after a human approves staging setup.
# NEVER store actual connection strings, passwords, tokens, or private keys in git.
# Runtime stays fail-closed: security.production mode is intentional even on staging.
# "production" here enables strict auth checks; it does NOT authorize launch.
SUPPORT_ENV=production
SUPPORT_AUTH_MODE=oidc
SUPPORT_POLICY_MODE=opa

# Separate PostgreSQL STAGING instance/DB; never reuse nexus-ai-automation-prod credentials.
# The runtime role must not own the schema or be allowed to run Alembic migrations.
DATABASE_URL=postgresql+psycopg://REPLACE_STAGING_ROLE:REPLACE_PASSWORD@127.0.0.1:15432/REPLACE_STAGING_DATABASE

# Use actual HTTPS identity-provider values configured for staging.
SUPPORT_OIDC_ISSUER=https://identity.staging.example.invalid
SUPPORT_OIDC_AUDIENCE=support-api-staging
SUPPORT_OIDC_JWKS_URL=https://identity.staging.example.invalid/.well-known/jwks.json

# Example is local-only OPA, which must be separately provisioned and audited.
SUPPORT_OPA_DECISION_URL=http://127.0.0.1:18181/v1/data/support/allow
SUPPORT_OPA_TIMEOUT_SECONDS=2
